+    np.savez_compressed(out_dir / "target_log_ratio.npz", h=res.target_log_ratio.numpy())
+    np.savez_compressed(out_dir / "update_source_pi.npz", pi=res.update_source_pi.numpy())
+    identity = res.target_log_ratio_check()
+    solution = {
