
# --- NBPO push excludes: secrets, caches, large artifacts ---
nhn/
.claude/
.TinyTeX/
.conda_tex/
.conda_tex_default/
.vllm051_pkgs/
data/
experiments/*
results/*
!nbpo_iclr/results/
!nbpo_iclr/results/**
!results/iclr2027_table1_v2/
!results/iclr2027_table1_v2/**
outputs/
wandb/
mlxp/
third_party/
__pycache__/
*.pyc
*.safetensors
*.bin
hf_cache/

# LaTeX build products
*.aux
*.log
*.blg
*.out
*.synctex.gz

# --- ICLR-2027 Table-1 rebuild ---
# `experiments/` above is a blanket exclusion for large artifacts, and it also
# swallowed `scripts/experiments/` -- which is source, not output. Re-include the
# source tree, and re-include the small records that ARE the scientific
# account of a run (audit, status, runbook, split manifests, decontamination
# report, frozen configs, run registry) while leaving decodes, judgments,
# checkpoints, logs and PID files out.
!scripts/experiments/
!scripts/experiments/**
scripts/experiments/**/__pycache__/
!experiments/iclr2027_table1_v2/
experiments/iclr2027_table1_v2/*
!experiments/iclr2027_table1_v2/*.md
!experiments/iclr2027_table1_v2/run_registry.jsonl
!experiments/iclr2027_table1_v2/run_registry.csv
!experiments/iclr2027_table1_v2/splits/
!experiments/iclr2027_table1_v2/configs_frozen/
!experiments/iclr2027_table1_v2/judge_audit/
!experiments/iclr2027_table1_v2/judge_audit_v2/
!experiments/iclr2027_table1_v2/judge_audit_v3_holdout/
!experiments/iclr2027_table1_v2/judge_protocol_v3/
!experiments/iclr2027_table1_v2/v4_dev_analysis/
!experiments/iclr2027_table1_v2/quarantine/
!experiments/iclr2027_table1_v2/judge_protocol_v4/
!experiments/iclr2027_table1_v2/splits_judge_v4/
!experiments/iclr2027_table1_v2/calibration/
# Calibration RUNS: keep the small reports and run manifests, leave the raw
# per-pair judgment rows out (they are judgment artifacts, and Section K says
# large raw judgments do not get pushed).
!experiments/iclr2027_table1_v2/calibration_runs/
experiments/iclr2027_table1_v2/calibration_runs/*
!experiments/iclr2027_table1_v2/calibration_runs/*_run_manifest.json
!experiments/iclr2027_table1_v2/calibration_runs/adaptive_pass/
!experiments/iclr2027_table1_v2/calibration_runs/all_templates_pass/
!experiments/iclr2027_table1_v2/calibration_all/
experiments/iclr2027_table1_v2/calibration_all/*
!experiments/iclr2027_table1_v2/calibration_all/*_run_manifest.json
!experiments/iclr2027_table1_v2/calibration_all/analysis/
!experiments/iclr2027_table1_v2/plans/
experiments/iclr2027_table1_v2/judge_audit/*
!experiments/iclr2027_table1_v2/judge_audit/report.json
!experiments/iclr2027_table1_v2/judge_audit/report.md

# SafeRLHF splits: the manifest travels (hashes, counts, graph statistics,
# disjointness proof) but the split files themselves do not. They are 122 MB of
# RAW RESPONSES from a public dataset, exactly reproducible from
# build_saferlhf_splits.py at the recorded seed, and Section K keeps raw
# responses out of the repository.
!experiments/iclr2027_table1_v2/saferlhf_splits/
experiments/iclr2027_table1_v2/saferlhf_splits/*
!experiments/iclr2027_table1_v2/saferlhf_splits/split_manifest.json

# v5 opaque-identifier factorial: reports and manifests only, not the raw
# per-rendering judgment rows.
!experiments/iclr2027_table1_v2/judge_protocol_v5/
experiments/iclr2027_table1_v2/judge_protocol_v5/*
!experiments/iclr2027_table1_v2/judge_protocol_v5/*.md
!experiments/iclr2027_table1_v2/judge_protocol_v5/*.json

# Pool pilot: keep the manifests, probability tensors and the analysis; leave the
# raw generated responses out (4 MB of model output, reproducible from
# generate_saferlhf_pools.py at the recorded seeds).
!results/iclr2027_table1_v2/pool_pilot/
results/iclr2027_table1_v2/pool_pilot/pool_responses.jsonl

# Progress PDF snapshots are deliverables and are kept.
!nbpo_iclr/progress_snapshots/
!nbpo_iclr/progress_snapshots/**
!nbpo_iclr/generated/
!nbpo_iclr/generated/**
