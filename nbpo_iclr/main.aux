\@writefile{lot}{\contentsline {table}{\numberline {19}{\ignorespaces Invariance of \textsc  {NBPO}{} under $\lambda ^{(A)}=(0.2,0.6,1.0,1.7)$, measured at three points in the pipeline, with the utilitarian rule as the control. Rows are ordered by how much machinery separates the measurement from Theorem~\ref {thm:fairness}. ``Sign flip'' is the percentage of the $37{,}800$ training pairs whose regression target changes sign under rescaling; ``max $|\Delta |$'' is the largest change in any one objective's held-out surplus between the two trained arms, and ``$\Delta $ min $s$'' the change in the minimum. Held-out quantities are on $100$ prompts under the pinned \texttt  {Qwen3-32B} oracle, the protocol of Table~\ref {tab:multi-dataset-surplus}, whose paired bootstrap resolution on a minimum surplus is approximately $\pm 0.03$---wider than either rule's movement in that block. The generated-text block decodes greedily at temperature $0$ and asks how often the rescaled arm reproduces its unrescaled twin token for token, alongside the floor obtained by retraining the unrescaled arm on identical targets with a different seed. Its rows are not bolded because the informative contrast there is between an effect and its own floor within a rule, not between the two rules.}}{29}{table.192}\protected@file@percent }
\newlabel{tab:scale-pipeline}{{19}{29}{Invariance of \NBPO {} under $\lambda ^{(A)}=(0.2,0.6,1.0,1.7)$, measured at three points in the pipeline, with the utilitarian rule as the control. Rows are ordered by how much machinery separates the measurement from Theorem~\ref {thm:fairness}. ``Sign flip'' is the percentage of the $37{,}800$ training pairs whose regression target changes sign under rescaling; ``max $|\Delta |$'' is the largest change in any one objective's held-out surplus between the two trained arms, and ``$\Delta $ min $s$'' the change in the minimum. Held-out quantities are on $100$ prompts under the pinned \texttt {Qwen3-32B} oracle, the protocol of Table~\ref {tab:multi-dataset-surplus}, whose paired bootstrap resolution on a minimum surplus is approximately $\pm 0.03$---wider than either rule's movement in that block. The generated-text block decodes greedily at temperature $0$ and asks how often the rescaled arm reproduces its unrescaled twin token for token, alongside the floor obtained by retraining the unrescaled arm on identical targets with a different seed. Its rows are not bolded because the informative contrast there is between an effect and its own floor within a rule, not between the two rules}{table.192}{}}
